{
  "id": "./?app=dilo",
  "name": "Dilo — Spanish you can use today",
  "short_name": "Dilo",
  "description": "A warm, speaking-first A1 Spanish course with real-life routes, listening practice, and saved progress.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f5ebdd",
  "theme_color": "#142a33",
  "categories": ["education", "language"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today’s Spanish", "short_name": "Today", "url": "./#today", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Spanish practice", "short_name": "Practice", "url": "./#practice", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Spanish phrasebook", "short_name": "Words", "url": "./#phrasebook", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
